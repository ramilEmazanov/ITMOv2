    {
      "parameters": {
        "jsCode": "const diff = $input.first().json.data;\nif (typeof diff !== 'string') throw new Error('Expected diff text in data');\nconst hunks = [];\nlet oldPath, newPath, hunk, oldLine, newLine;\nfunction pathFromHeader(value) {\n  if (value === '/dev/null') return null;\n  if (value.startsWith('\"')) {\n    throw new Error('Quoted/escaped file paths need a dedicated diff parser');\n  }\n  return value.replace(/^[ab]\\//, '');\n}\nfor (const line of diff.split(/\\r?\\n/)) {\n  if (line.startsWith('diff --git ')) {\n    oldPath = newPath = undefined; hunk = undefined;\n  } else if (!hunk && line.startsWith('--- ')) {\n    oldPath = pathFromHeader(line.slice(4));\n  } else if (!hunk && line.startsWith('+++ ')) {\n    newPath = pathFromHeader(line.slice(4));\n  } else if (/^@@ /.test(line)) {\n    const m = line.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (!m) throw new Error('Unsupported hunk header');\n    oldLine = Number(m[1]); newLine = Number(m[2]);\n    hunk = { id: 'h' + (hunks.length + 1), path: newPath ?? oldPath, diff: line, range: null };\n    hunks.push(hunk);\n  } else if (hunk) {\n    hunk.diff += '\\n' + line;\n    if (line.startsWith('+')) {\n      if (!hunk.range || hunk.range.side === 'LEFT') {\n        hunk.range = { start_line: newLine, line: newLine, side: 'RIGHT' };\n      } else {\n        hunk.range.line = newLine;\n      }\n      newLine++;\n    } else if (line.startsWith('-')) {\n      if (!hunk.range) {\n        hunk.range = { start_line: oldLine, line: oldLine, side: 'LEFT' };\n      } else if (hunk.range.side === 'LEFT') {\n        hunk.range.line = oldLine;\n      }\n      oldLine++;\n    } else if (line.startsWith(' ')) {\n      oldLine++; newLine++;\n    }\n  }\n}\nconst usable = hunks.filter(h => h.path && h.range);\nif (!usable.length) throw new Error('No reviewable text hunks: check empty/binary-only diff');\nreturn [{ json: { hunks: usable, review_input: JSON.stringify(usable.map(({id,path,diff}) => ({id,path,diff}))) } }];"
      },
      "id": "f685c68c-6bdf-4db2-a9f7-ec1228c4757f",
      "name": "Parse Hunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst result = typeof raw === 'string' ? JSON.parse(raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '')) : raw;\nif (!Array.isArray(result?.comments)) throw new Error('Model must return {comments:[{id,body}]}');\nconst hunks = $('Parse Hunks').first().json.hunks;\nconst byId = new Map();\nfor (const c of result.comments) {\n  if (!hunks.some(h => h.id === c.id) || byId.has(c.id) || typeof c.body !== 'string' || !c.body.trim()) {\n    throw new Error('Invalid/duplicate hunk ID or empty review body');\n  }\n  byId.set(c.id, c.body.trim());\n}\nif (byId.size !== hunks.length) throw new Error('Model must review every hunk');\nconst comments = hunks.map(h => {\n  const r = h.range;\n  if (!r || !Number.isInteger(r.start_line) || !Number.isInteger(r.line) || r.start_line < 1 || r.line < r.start_line || !['LEFT', 'RIGHT'].includes(r.side)) {\n    throw new Error('Invalid line range for ' + h.id);\n  }\n  const comment = { path: h.path, line: r.line, side: r.side, body: byId.get(h.id) };\n  // GitHub requires range fields only for comments spanning multiple lines.\n  if (r.start_line < r.line) {\n    comment.start_line = r.start_line;\n    comment.start_side = r.side;\n  }\n  return comment;\n});\nreturn [{ json: { event: 'COMMENT', body: 'AI inline review — ' + $('Prepare PR').first().json.review_type, comments } }];"
      },
      "id": "45d3fa6f-de78-49ac-a1ce-3689d6a30cef",
      "name": "Build Inline Review",
