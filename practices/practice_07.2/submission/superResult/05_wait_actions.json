      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const i = $input.first().json;\nif (!/^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$/.test(i.repo ?? '')\n    || !/^\\d+$/.test(String(i.actions_run_id ?? ''))\n    || typeof i.expected_title !== 'string'\n    || !i.expected_path?.startsWith('.github/workflows/')) throw new Error('Invalid wait inputs');\nconst timeout = Number(i.timeout_seconds ?? 1500);\nconst poll = Number(i.poll_seconds ?? 15);\nif (!Number.isFinite(timeout) || timeout < 15 || timeout > 3600\n    || !Number.isFinite(poll) || poll < 5 || poll > 60) throw new Error('Invalid polling settings');\nreturn [{json: {...i, actions_run_id: String(i.actions_run_id), timeout_seconds: timeout,\n  poll_seconds: poll, started_ms: Date.now()}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "49f3997c-3cac-40c0-a3b4-effda8eda35e",
      "name": "Wait Input"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.github.com/repos/' + $('Wait Input').first().json.repo + '/actions/runs/' + $('Wait Input').first().json.actions_run_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2026-03-10"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        0
      ],
      "id": "bd147914-0cdb-426c-9c71-8d9866e36a23",
      "name": "Poll Run",
      "credentials": {
        "githubApi": {
          "id": "KKi0v4T6OdNEEJWf",
          "name": "GitHub account 59"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $('Wait Input').first().json;\nconst run = $input.first().json;\nif (Date.now() - input.started_ms > input.timeout_seconds * 1000) throw new Error('Actions polling timeout');\nif (String(run.id) !== input.actions_run_id || run.repository?.full_name !== input.repo\n    || run.event !== 'workflow_dispatch' || run.display_title !== input.expected_title\n    || String(run.path ?? '').split('@')[0] !== input.expected_path) throw new Error('Unexpected Actions run');\nreturn [{json: {...input, completed: run.status === 'completed',\n  conclusion: run.conclusion ?? null, actions_status: run.status, actions_url: run.html_url}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "id": "66c65402-b9a7-4739-a945-2960a3ccc44b",
