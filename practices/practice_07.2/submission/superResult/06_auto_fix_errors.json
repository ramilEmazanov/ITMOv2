      "name": "Find Failed Fix",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const error = $('Error Context').first().json;\nconst rows = $input.all().map(i=>i.json).filter(r=>r.n8n_execution===error.n8n_execution);\nif (rows.length !== 1 || ['merged','rejected','blocked','ready_for_merge'].includes(rows[0].status)) return [];\nreturn [{json:{issue_key:rows[0].issue_key,status:'failed',error:error.error_node + ': ' + error.error,updated_at:error.updated_at}}];\n"
      },
      "type": "n8n-nodes-base.code",
