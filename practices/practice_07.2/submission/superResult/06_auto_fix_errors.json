      "parameters": {
        "jsCode": "const input = $input.first().json;\nif (!input.execution?.id) throw new Error('No parent execution ID in error payload');\nreturn [{json:{n8n_execution:String(input.execution.id),\n error: String(input.execution.error?.message ?? 'Unknown workflow failure').slice(0,4000),\n error_node:input.execution.lastNodeExecuted ?? '', updated_at:new Date().toISOString()}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "35b86eda-4cd9-41b7-a20a-72f2c20171fe",
