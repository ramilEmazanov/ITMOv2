      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// В этом workflow один webhook содержит один Issue.\nconst issue = $('Prepare Issue').first().json;\nconst { type, confidence } = $json;\n\nconst knownType = ['bug', 'task', 'feature'].includes(type);\nconst confident = typeof confidence === 'number'\n  && Number.isFinite(confidence)\n  && confidence >= 0.8 && confidence <= 1;\nconst route = knownType && confident ? type : 'unknown';\n\nreturn {\n  json: {\n    ...issue,\n    type,\n    confidence,\n    route,\n    label: route === 'unknown' ? 'needs-triage' : route,\n  },\n};\n"
      },
