{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/google/gemma-4-e4b",
  "small_model": "lmstudio/google/gemma-4-e4b",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B MLX 4-bit (LM Studio)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
